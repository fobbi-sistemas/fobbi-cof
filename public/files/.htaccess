# ======================================================================
# Pasta de uploads (imagens do blog e do site).
#
# Os arquivos sao servidos normalmente, mas nada aqui dentro executa:
# um .php enviado por upload vira arquivo estatico, nunca script.
#
# NAO adicionar RewriteEngine aqui: isso descartaria as regras de
# rewrite do diretorio pai dentro desta pasta.
# ======================================================================

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php5 .php7 .php8
RemoveType .php .phtml .php5 .php7 .php8

<FilesMatch "\.(php|phtml|php5|php7|php8|phar)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
